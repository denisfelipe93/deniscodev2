---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "DenisCode",
  description = "Tecnologia, infraestrutura e soluções digitais pensadas como negócio.",
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <meta name="description" content={description} />

    <title>{title}</title>
  </head>

  <body>
    <slot />
  </body>
</html>